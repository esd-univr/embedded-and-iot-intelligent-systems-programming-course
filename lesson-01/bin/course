#!/usr/bin/env bash
# Run a command in the course toolchain container with a repository checkout
# (or a lesson student workspace) mounted at /work.
#
#   course                      interactive shell
#   course west build ...       run one command
#   course doctor               check the toolchain
#
# Inside the course container itself it just runs the command.
# Env: COURSE_IMAGE (default embedded-iot-course:<TOOLCHAIN_VERSION>)
#      COURSE_ENGINE (default docker)
# The container needs no USB access: flash with UF2 copy and read the serial
# port on the host (see the lab handout).
set -euo pipefail

# Already inside the course container (a dev container or Codespace): there is
# no Docker to call, so run the command directly.
if [ -f /etc/course-pins ] && [ -n "${ZEPHYR_BASE:-}" ]; then
  if [ "$#" -eq 0 ]; then set -- bash -l; fi
  if [ "$1" = doctor ]; then set -- course-doctor; fi
  exec "$@"
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Course checkout: bin/ lives in toolchain/. Student package: bin/ is at the root.
if [ -f "$here/../versions.env" ]; then
  root="$(cd "$here/../.." && pwd)"; pins="$here/../versions.env"
else
  root="$(cd "$here/.." && pwd)"; pins="$here/versions.env"
fi
# shellcheck disable=SC1090
. "$pins"

ENGINE="${COURSE_ENGINE:-docker}"
if ! command -v "$ENGINE" >/dev/null 2>&1; then
  echo "error: '$ENGINE' was not found. Install Docker (Docker Desktop on macOS), start it, then retry." >&2
  exit 2
fi
WORKDIR="${COURSE_WORKDIR:-/work}"
if ! "$ENGINE" info >/dev/null 2>&1; then
  echo "error: Docker is installed but its engine is not running. Start Docker (Desktop on macOS), wait until it is ready, then retry." >&2
  exit 2
fi

# Image: COURSE_IMAGE, else the locally built tag, else the published one.
local_image="${IMAGE_REPOSITORY##*/}:${TOOLCHAIN_VERSION}"
published_image="${IMAGE_REPOSITORY}:${TOOLCHAIN_VERSION}"
if [ -n "${COURSE_IMAGE:-}" ]; then
  IMAGE="$COURSE_IMAGE"
elif "$ENGINE" image inspect "$local_image" >/dev/null 2>&1; then
  IMAGE="$local_image"
else
  IMAGE="$published_image"
fi

if ! "$ENGINE" image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "error: image $IMAGE not found. Download it once with:" >&2
  echo "       $ENGINE pull $published_image" >&2
  exit 2
fi

tty=()
[ -t 0 ] && [ -t 1 ] && tty=(-it)

# Start in the same relative directory inside the container.
rel="${PWD#"$root"}"
case "$PWD" in "$root"|"$root"/*) workdir="$WORKDIR$rel" ;; *) workdir="$WORKDIR" ;; esac

if [ "$#" -eq 0 ]; then set -- bash -l; fi
if [ "$1" = doctor ]; then set -- course-doctor; fi

exec "$ENGINE" run --rm ${tty[@]+"${tty[@]}"} \
  --user "$(id -u):$(id -g)" \
  -v "$root:$WORKDIR" -w "$workdir" \
  -e HOME=/tmp/home \
  "$IMAGE" "$@"

# Single source of truth for every pinned version. Plain KEY=VALUE so that
# make, bash and `docker build --build-arg` can all read it unchanged.
# Each key is also a Containerfile ARG; scripts/check-pins.sh enforces that.
# Baseline recorded 2026-10-06. Zephyr 4.4.x is supported until 2027-04-12,
# which covers the whole 2026/2027 course (last lab 2027-01-27).

# Image tag: bump when anything below changes.
TOOLCHAIN_VERSION=0.1.0

# Ubuntu 24.04 (index digest, multi-arch).
BASE_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

# Zephyr RTOS. The tag fixes every west module revision via the manifest.
ZEPHYR_REF=v4.4.2
ZEPHYR_COMMIT=dccb09599635bdff17633fa7e9dab014b91dce90

# Zephyr SDK 1.0.1 (the SDK that Zephyr 4.4.2 declares in its SDK_VERSION file).
# Minimal bundle (CMake package + host tools) plus only the arm-zephyr-eabi
# toolchain (Pico 2 / Cortex-M33). Every archive is verified by SHA-256, one
# set per image architecture (amd64 -> x86_64, arm64 -> aarch64).
SDK_VERSION=1.0.1
SDK_MINIMAL_SHA256_X86_64=ca9bc0ff66fafca1dac9d592a36d953cf16d096a9d09b1c0357f021cf9f6a7eb
SDK_MINIMAL_SHA256_AARCH64=d79c5bfc68e679488659bea289a4026e52a64f03338875c8c9c850fff13cee30
SDK_ARM_SHA256_X86_64=21b85981cb5a1818d9bc53d82af80f208946ec038b982ff1907287572ed3a634
SDK_ARM_SHA256_AARCH64=b9805b691f2f0a8926c92694cae378d05ba07b76abca745e216fcc52753cc4d6

# Comma-separated Zephyr modules fetched into the image (rest of manifest skipped).
ZEPHYR_MODULES=hal_rpi_pico,cmsis_6
